# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Local development only: run the agent against a local Ollama server, or
# a canned fake model, instead of Gemini/Vertex. Never set this in a
# deployed environment — Vertex AI Agent Engine cannot reach a developer's
# localhost and has no use for canned responses; no deploy path sets it,
# and it refuses to construct if run under one anyway. Neither alternative
# needs any API key or credential. web_search is stubbed out (unavailable)
# on both, and eval scores are not meaningful on either — see
# discussion-agent/README.md. If backend/'s suggestions/journal calls
# should also go local, set the matching LLM_BACKEND in backend/.env too
# (a separate, independent setting — see backend/.env.example).
LLM_BACKEND=vertex
# OLLAMA_MODEL=your-tool-calling-capable-model  # only needed for ollama
# OLLAMA_API_BASE=http://localhost:11434  # only used for ollama
