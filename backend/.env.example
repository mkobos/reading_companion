# Workspace store: app/main.py's _use_firestore() picks one of three
# implementations based on the two vars below —
#   1. GOOGLE_CLOUD_PROJECT set, FIRESTORE_EMULATOR_HOST unset: real
#      Firestore (production/staging) — app/store/firestore_store.py.
#   2. FIRESTORE_EMULATOR_HOST set (regardless of GOOGLE_CLOUD_PROJECT):
#      the local Firestore emulator (requires `gcloud emulators firestore
#      start`) — same FirestoreStore code path, pointed at the emulator.
#   3. Both unset/commented out: an in-process InMemoryWorkspaceStore
#      (app/store/memory_store.py) — dev/test convenience ONLY, never a
#      production option. No persistence at all: all workspaces/documents/
#      notes/discussions/journals are lost on every backend restart, and
#      it only exists within this one process (no multi-instance
#      consistency). This is the default when nothing below is set.
GOOGLE_CLOUD_PROJECT=[[GCP_PROJECT_ID]]

# Uncomment for local development against the Firestore emulator instead of
# real Firestore (requires `gcloud emulators firestore start`):
# FIRESTORE_EMULATOR_HOST=localhost:8080

# GCS bucket for raw uploaded documents. If unset, an in-memory fake blob
# store is used instead (local dev / tests).
GCS_BUCKET_NAME=

# Max upload size in bytes for a workspace document.
MAX_UPLOAD_SIZE_BYTES=2000000

# Rate limits: max requests per window, per (workspace or IP), per endpoint.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated list of allowed CORS origins for the frontend SPA.
ALLOW_ORIGINS=

# Base URL of a locally-running discussion-agent process (its
# reasoning_engine adapter routes: /api/reasoning_engine,
# /api/stream_reasoning_engine). Not yet an Agent Engine deployment — see
# docs/repo_configuration_progress.md.
DISCUSSION_AGENT_URL=http://localhost:8080

# Timeout (seconds) for a single discussion-agent HTTP call (session
# creation or a turn). Bounds how long a hung agent process can hold a
# backend request and a rate-limiter slot open.
DISCUSSION_AGENT_TIMEOUT_SECONDS=30

# Test/CI-only: set to "1" or "true" to replace DiscussionAgentClient with an
# in-process fake (canned response, no HTTP) so discussions work without a
# running discussion-agent process. Default off — never set in real use.
DISCUSSION_AGENT_FAKE=false
# Test/CI-only: artificial delay (milliseconds) added to the fake client's
# run_turn, to exercise pending-state UI. Only read when the flag above is on.
DISCUSSION_AGENT_FAKE_DELAY_MS=0

# Gemini access for the suggestions/journal plain LLM calls (app/llm_client.py).
# Defaults to Vertex AI, reusing GOOGLE_CLOUD_PROJECT above.
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_LOCATION=global
# Alternatively, for Gemini API via Google AI Studio, comment out the two
# lines above and uncomment:
# GEMINI_API_KEY=[[GEMINI_API_KEY]]

# Models for the two plain (non-agent) LLM calls. Evergreen aliases resolve
# for the Flash tier on this project/region as of 2026-07-07 — re-check at
# the next implementation touch point (see technical_specification.md §8).
SUGGESTIONS_MODEL=gemini-flash-latest
JOURNAL_MODEL=gemini-flash-latest

# Timeout (seconds) for a single suggestions/journal LLM call. Sized for
# cloud Gemini Flash calls; a local LLM_BACKEND=ollama model (CPU-bound,
# no dedicated GPU) can easily take 15-30+ seconds per call — raise this
# (e.g. 60) when using that backend, or calls will spuriously 503.
LLM_TIMEOUT_SECONDS=15

# Local development only: run suggestions/journal against a local Ollama
# server, or a canned fake, instead of Gemini/Vertex (vertex | ollama |
# fake; default vertex). This governs backend's own suggestions/journal
# calls ONLY — it does not affect discussions, which go through a separate
# discussion-agent process with its own independent LLM_BACKEND (see
# discussion-agent/.env.example); DISCUSSION_AGENT_FAKE above is the
# unrelated switch for whether backend talks to a real agent process at
# all. Never set this in a deployed environment — it refuses to construct
# ("ollama"/"fake") if a Cloud Run/Agent Engine runtime is detected anyway.
# Neither alternative needs any API key or credential.
LLM_BACKEND=vertex
# OLLAMA_MODEL=your-model-with-json-schema-support  # only needed for ollama
# OLLAMA_API_BASE=http://localhost:11434  # only used for ollama

# Test/CI-only: set to "1" or "true" to make the LLM_BACKEND=fake client
# raise LlmUnavailableError on every call, to exercise the 503 path.
LLM_FAKE_FORCE_ERROR=false

# Observability (app/telemetry.py). All default to off/plain so local dev
# and tests need no GCP credentials or network access.
#
# Set to "true" (with GOOGLE_CLOUD_PROJECT set above) to export HTTP request
# spans to Cloud Trace. Never captures request/response body content.
ENABLE_CLOUD_TRACE=false
# "json" emits structured, trace-correlated logs to stdout via
# google-cloud-logging's StructuredLogHandler (no network calls -- Cloud
# Run's logging agent reads stdout). "plain" (default) uses a plain
# logging.StreamHandler.
LOG_FORMAT=plain
# Local-only: print spans to stdout via OTel's ConsoleSpanExporter for
# debugging, without needing ENABLE_CLOUD_TRACE/GCP credentials.
OTEL_CONSOLE_EXPORT=false
